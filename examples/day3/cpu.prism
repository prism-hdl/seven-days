// =============================================================================
// cpu.prism —— 第三日 · 第 10 集：把四颗器官放进同一具身体
//
// 第二日的器官（pc / regfile / alu / ram / decoder）从 iu.prism 取来，
// 再补一颗只读的指令存储器 im（照 ram 的样子去掉写口、阵列里烘焙进程序），
// 用一份 design 的 wire 与 connect 串成一颗能跑 RV32I 程序的【单周期 CPU】。
//
// 哈佛架构：指令与数据各走各的存储器（im / dm），
// 所以取指与访存可以在同一拍里同时发生。
//
// 数据面与控制面在这一层合流，也在这一层再次分开：
//   数据面：rf.rdata1/2 → alu → ex.result → （dm / 写回）→ rf.wdata
//   控制面：ctl.* 一束控制位，决定"这一拍允许什么发生"
//
// 程序（6 条指令，一个真循环）：
//     0: addi x1, x0, 0      累加和 x1 = 0（5+4+3+2+1 = 15）
//     4: addi x2, x0, 5      计数 x2 = 5
//     8: add  x1, x1, x2     ← 循环体：和 += 计数
//    12: addi x2, x2, -1     计数 -= 1
//    16: bne  x2, x0, -8      计数 ≠ 0 就回 8
//    20: jal  x0, 0           停机（自跳）
// =============================================================================

import "iu.prism"

// ---- 指令存储器：一块直读 ROM（程序烘焙在里面，组合读）----
module im {
    in  addr  : Signal<u6>
    out rdata : Signal<u32>

    mem mem : [64] u32 = [
        0x00000093,   //  0: addi x1, x0, 0      x1 = 0
        0x00500113,   //  4: addi x2, x0, 5      x2 = 5
        0x002080b3,   //  8: add  x1, x1, x2     x1 += x2  ← 循环体
        0xfff10113,   // 12: addi x2, x2, -1     x2 -= 1
        0xfe011ce3,   // 16: bne  x2, x0, -8     若 x2 ≠ 0 → 回 8
        0x0000006f    // 20: jal  x0, 0          停机（自跳）
    ]

    rdata = mem[addr]
}

@schedule im {
    bitwidth  : { data:32 }
    pipeline  : 1 stage
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : none
    latency   : 1 cycle
}

design cpu_top {
    // ==== 六颗实例 ====
    pc  : pc<T = i32>
    rf  : regfile<T = i32>
    ex  : alu<T = i32>
    rom : im
    dm  : ram<SIZE = 64>
    ctl : decoder

    // ==== 取指：pc → rom（组合读，同拍出指令）====
    wire iaddr : u6  = pc.addr[7:2] -> rom.addr      // 字节地址 → 字地址
    wire instr : u32 = rom.rdata -> ctl.instr

    // ==== 译码输出 → 寄存器堆读口 ====
    connect ctl.rs1 -> rf.raddr1
    connect ctl.rs2 -> rf.raddr2
    connect ctl.rd  -> rf.waddr

    // ==== ALU 两个操作数 ====
    wire alu_a : i32 = rf.rdata1 -> ex.a
    wire alu_b : i32 = ctl.alu_src ? ctl.imm : rf.rdata2 -> ex.b
    wire alu_f : u4  = ctl.alu_op -> ex.op

    // ==== 分支条件：借 ALU 的比较结果，按 funct3 选"成不成立" ====
    wire f3    : u3 = instr[14:12]
    wire br_eq : u1 = ex.result == 0                  // SUB 得 0 → 相等
    wire br_lt : u1 = ex.result == 1                  // SLT/SLTU 得 1 → 小于
    wire br_ok : u1 = match f3 {
        0 => br_eq,                    // beq：相等即成立
        1 => br_eq == 0,               // bne：取反
        4 => br_lt,                    // blt
        5 => br_lt == 0,               // bge
        6 => br_lt,                    // bltu
        _ => br_lt == 0,               // bgeu
    }

    // ==== PC 下一步：分支成立 / jal / jalr 都算"载入" ====
    wire pc_load   : u1  = (ctl.is_branch & br_ok) | ctl.is_jal | ctl.is_jalr -> pc.load
    wire pc_target : i32 = ctl.is_jalr ? (rf.rdata1 + ctl.imm) : (pc.addr + ctl.imm)
    connect pc_target -> pc.target

    // ==== 访存：字地址、写数据、读写使能 ====
    wire dm_addr  : u6  = ex.result[7:2] -> dm.addr
    wire dm_wdata : u32 = rf.rdata2 -> dm.wdata
    connect ctl.mem_ren -> dm.ren

    // ==== 非法指令：这一拍什么都不许落地 ====
    wire legal : u1 = ctl.is_illegal == 0
    wire rf_wen_eff : u1 = ctl.reg_wen & legal -> rf.wen
    wire dm_wen_eff : u1 = ctl.mem_wen & legal -> dm.wen

    // ==== 写回三选一：load 数据 / 链接地址(pc+4) / ALU 结果 ====
    wire is_link : u1 = ctl.is_jal | ctl.is_jalr
    wire wb_data : i32 = ctl.mem_ren ? i32(dm.rdata) : (is_link ? (pc.addr + 4) : ex.result)
    connect wb_data -> rf.wdata

    // ==== 观测：把 pc 与两个寄存器引到顶层 ====
    expose pc.pc as pcv
    expose rf.regs[1] as x1
    expose rf.regs[2] as x2
}

// 24 拍自由运行（无 stim——CPU 自己跑）。逐拍手算：
//   拍 0     addi x1, x0, 0 落地：x1 = 0，pc 走到 4
//   拍 1     addi x2, x0, 5 落地：x2 = 5，pc 走到 8
//   拍 2..15 循环体五轮（x2 = 5,4,3,2,1 各一轮），每轮三拍
//            x1 += x2  →  x2 -= 1  →  x2 ≠ 0 则跳回 8
//            五轮之后 x1 = 5+4+3+2+1 = 15，x2 = 0
//   拍 16    x2 已归零，16 处的分支不成立 → 顺行到 20
//   拍 17 起 20: jal x0, 0 自跳；pc 停在 20、寄存器不再变
run cpu_check of cpu_top {
    until : for 24 cycles
    show  : { pcv, x1, x2 }
}
