// =============================================================================
// iu.prism —— 第三日 · 第 10 集：四颗器官（合体前最后一次单独出现）
//
// 第二日造的四颗器官在这里集合成一份文件，等 cpu.prism 用 import 取用：
//   pc / regfile / alu / ram / decoder
//
// 相对第二日只有一处改动（合体时才暴露出来的）：
//   · decoder 的 alu_op 现在也管分支——beq/bne 走 SUB、blt/bge 走 SLT、
//     bltu/bgeu 走 SLTU。第 8 集那版只覆盖 R/I 型（其余一律借用 ADD 通路
//     去算地址），因为那时没有下游要用"比较结果"这个数。
//
// ram 一个字都没改：它本来就是字寻址（addr 是 u6）。变的只是顶层的接法——
// pc 给的是字节地址，进 ram 之前切掉低两位（见 cpu.prism 的 iaddr/dm_addr）。
//
// 其余原样搬过来——这正是"每颗器官都能单独测"的红利：合体时不必重写。
// =============================================================================

module pc<T: bits> {
    in  load   : Signal<u1>    // 1 = 载入 target（跳转 / 分支），0 = 自增 +4
    in  target : Signal<T>     // 跳转目标（字节地址）
    out addr   : Signal<T>     // 当前 PC（字节地址）

    reg pc : T

    on clock {
        pc' = load ? target : pc + 4
    }

    addr = pc
}

module regfile<T: bits> {
    in  raddr1 : Signal<u5>
    in  raddr2 : Signal<u5>
    in  waddr  : Signal<u5>
    in  wdata  : Signal<T>
    in  wen    : Signal<u1>
    out rdata1 : Signal<T>
    out rdata2 : Signal<T>

    mem regs : [32] T = 0

    rdata1 = (raddr1 == 0) ? 0 : regs[raddr1]
    rdata2 = (raddr2 == 0) ? 0 : regs[raddr2]

    on clock {
        regs'[waddr] = (wen & (waddr != 0)) ? wdata : regs[waddr]
    }
}

module alu<T: bits> {
    in  a      : Signal<T>
    in  b      : Signal<T>
    in  op     : Signal<u4>
    out result : Signal<T>

    result = match op {
        0 => a + b,              // ADD
        1 => a - b,              // SUB
        2 => a & b,              // AND
        3 => a | b,              // OR
        4 => a ^ b,              // XOR
        5 => a << b,             // SLL
        6 => a >> b,             // SRA
        7 => a < b,              // SLT
        8 => T(u(a) >> b),       // SRL
        9 => u(a) < u(b),        // SLTU
        _ => 0,
    }
}

module ram<SIZE: int> {
    in  addr  : Signal<u6>      // 字地址 0..63（64 字 = 256 字节）
    in  wdata : Signal<u32>
    out rdata : Signal<u32>
    in  wen   : Signal<u1>
    in  ren   : Signal<u1>

    mem mem : [SIZE] u32 = 0

    rdata = ren ? mem[addr] : 0

    on clock {
        if (wen) {
            mem'[addr] = wdata
        }
    }
}

module decoder {
    in  instr : Signal<u32>

    out rd        : Signal<u5>
    out rs1       : Signal<u5>
    out rs2       : Signal<u5>
    out alu_op    : Signal<u4>
    out alu_src   : Signal<u1>
    out imm       : Signal<i32>
    out reg_wen   : Signal<u1>
    out mem_ren   : Signal<u1>
    out mem_wen   : Signal<u1>
    out is_branch : Signal<u1>
    out is_jal    : Signal<u1>
    out is_jalr   : Signal<u1>
    out is_illegal: Signal<u1>

    opcode = instr[6:0]
    funct3 = instr[14:12]
    funct7 = instr[31:25]

    rd_raw = instr[11:7]
    rs1    = instr[19:15]
    rs2    = instr[24:20]

    itype = match opcode {
        0x33 => 5,     // R：没有立即数
        0x13 => 0,     // I：addi
        0x03 => 0,     // I：load
        0x67 => 0,     // I：jalr
        0x23 => 1,     // S：store
        0x37 => 2,     // U：lui
        0x17 => 2,     // U：auipc
        0x63 => 3,     // B：branch
        0x6f => 4,     // J：jal
        _    => 5,
    }

    i_raw = instr >> 20
    i_imm = i_raw >= 0x800 ? i_raw - 0x1000 : i_raw

    s_raw  = (((instr >> 25) & 0x7f) << 5) | ((instr >> 7) & 0x1f)
    s_imm  = s_raw >= 0x800 ? s_raw - 0x1000 : s_raw

    b12    = (instr >> 31) & 0x1
    b11    = (instr >> 7)  & 0x1
    b10_5  = (instr >> 25) & 0x3f
    b4_1   = (instr >> 8)  & 0xf
    b_raw  = (b12 << 12) | (b11 << 11) | (b10_5 << 5) | (b4_1 << 1)
    b_imm  = b_raw >= 0x1000 ? b_raw - 0x2000 : b_raw

    j20    = (instr >> 31) & 0x1
    j19_12 = (instr >> 12) & 0xff
    j11    = (instr >> 20) & 0x1
    j10_1  = (instr >> 21) & 0x3ff
    j_raw  = (j20 << 20) | (j19_12 << 12) | (j11 << 11) | (j10_1 << 1)
    j_imm  = j_raw >= 0x100000 ? j_raw - 0x200000 : j_raw

    imm = match itype {
        0 => i_imm,
        1 => s_imm,
        2 => (instr >> 12) << 12,
        3 => b_imm,
        4 => j_imm,
        _ => 0,
    }

    // R 型与 I 型共用同一张 funct3 表；funct7 == 0x20 是"算术变体"标志
    alu_op_r = match funct3 {
        0 => (funct7 == 0x20) ? 1 : 0,   // SUB / ADD
        1 => 5,                          // SLL
        2 => 7,                          // SLT
        3 => 9,                          // SLTU
        4 => 4,                          // XOR
        5 => (funct7 == 0x20) ? 6 : 8,   // SRA / SRL
        6 => 3,                          // OR
        _ => 2,                          // AND
    }

    // 分支也借 ALU 做比较：beq/bne 走 SUB（结果 0 表示相等），
    // blt/bge 走 SLT，bltu/bgeu 走 SLTU。这是合体时新增的一条分派。
    alu_op_b = match funct3 {
        0 => 1,                          // beq  → SUB
        1 => 1,                          // bne  → SUB
        4 => 7,                          // blt  → SLT
        5 => 7,                          // bge  → SLT
        6 => 9,                          // bltu → SLTU
        _ => 9,                          // bgeu → SLTU
    }

    is_r      = (opcode == 0x33)
    is_i_alu  = (opcode == 0x13)
    is_load   = (opcode == 0x03)
    is_store  = (opcode == 0x23)
    is_lui    = (opcode == 0x37)
    is_auipc  = (opcode == 0x17)
    is_b      = (opcode == 0x63)
    is_j      = (opcode == 0x6f)
    is_jr     = (opcode == 0x67)

    alu_op  = (is_r | is_i_alu) ? alu_op_r : (is_b ? alu_op_b : 0)
    alu_src = (is_i_alu | is_load | is_jr | is_store | is_lui) ? 1 : 0

    reg_wen   = is_r | is_i_alu | is_load | is_lui | is_auipc | is_j | is_jr
    mem_ren   = is_load
    mem_wen   = is_store
    is_branch = is_b
    is_jal    = is_j
    is_jalr   = is_jr

    rd = reg_wen ? rd_raw : 0

    known = opcode in [0x33, 0x13, 0x03, 0x23, 0x37, 0x17, 0x63, 0x6f, 0x67]
    is_illegal = known ? 0 : 1
}

@schedule pc {
    bitwidth  : { data:64 }
    pipeline  : 1 stage
    storage   : pc = reg, width = param(T)
    interface : load, target, addr = Signal
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : adder = parallel(1)
    latency   : 1 cycle
}

@schedule regfile {
    bitwidth  : { data:64 }
    pipeline  : 1 stage
    storage   : regs = reg_array, depth = 32, width = param(T)
    interface : raddr1, raddr2, waddr, wdata, wen, rdata1, rdata2 = Signal
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : none
    latency   : 1 cycle
}

@schedule alu {
    bitwidth  : { data:64 }
    pipeline  : 1 stage
    storage   : none
    interface : a, b, op, result = Signal
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : adder = parallel(1)
    latency   : 1 cycle
}

@schedule ram {
    bitwidth  : { data:32 }
    pipeline  : 1 stage
    storage   : mem = reg_array, depth = 64, width = 32
    interface : addr, wdata, rdata, wen, ren = Signal
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : none
    latency   : 1 cycle
}

@schedule decoder {
    bitwidth  : { data:32 }
    pipeline  : 1 stage
    storage   : none
    interface : instr, rd, rs1, rs2, alu_op, alu_src, imm, reg_wen, mem_ren, mem_wen, is_branch, is_jal, is_jalr, is_illegal = Signal
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : none
    latency   : 1 cycle
}
