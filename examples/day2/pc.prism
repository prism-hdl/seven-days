// =============================================================================
// pc.prism —— 第二日 · 第 5 集：PC，下一步走哪儿
//
// 一颗只做一件事的模块：每拍往前走一步。
//   pc' = load ? target : pc + 4      （RISC-V 指令定长 4 字节）
// 复位到 0 —— 上电后第一条指令的地址。
//
// 宽度钉死 u64：PC 是 64 位地址，和寄存器堆同口径。这颗模块体内没有一处逻辑随
// 宽度分岔（只有一次加法、一个二选一），泛型只是多备一份同一条路的样本。
//
// 就这两行，CPU 会自己往前走。谁在这里按下"跳转"，谁就改变了整个程序的走向。
// =============================================================================

module pc {
    in  load   : Signal<u1>    // 1 = 载入 target（跳转），0 = 自增 +4
    in  target : Signal<u64>   // 跳转目标地址
    out addr   : Signal<u64>   // 当前 PC 值

    reg pc : u64

    on clock {
        pc' = load ? target : pc + 4
    }

    addr = pc
}

@schedule pc {
    bitwidth  : { data:64 }
    pipeline  : 1 stage
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : adder = parallel(1)
    latency   : 1 cycle
}

design pc_top {
    dut : pc
}

// 六拍就是那段循环的头六拍（地址取真实形状：0 / 4 / 8 / 12 / 16，loop 标号在 8）。
// 观测点在边沿之后，所以拍 0 的 addr 已经是 4，不是复位值 0。
run pc_check of pc_top {
    stim : {
        load, target, [addr] = {
            0,  0, [  4],   // addi x1, x0, 0    —— 顺行：0 + 4
            0,  0, [  8],   // addi x2, x0, 5    —— 顺行：4 + 4
            0,  0, [ 12],   // add  x1, x1, x2   —— 顺行：8 + 4（这格就是 loop）
            0,  0, [ 16],   // addi x2, x2, -1   —— 顺行：12 + 4
            1,  8, [  8],   // bne  x2, x0, -8   —— 载入：跳到 loop = 8
            0,  0, [ 12],   // add  x1, x1, x2   —— 第二轮，又顺行
        }
    }
    until : end of stim
    show  : { load, target, addr }
}
