// =============================================================================
// cpu.prism —— 第二日 · 第 9 集：把四颗器官放进同一具身体
//
// 器官从第 5–8 集的文件里 import 进来，一份都不重写；再补两颗存储器实例
// （同一份 ram，例化两次）与一份 design 的 wire / connect，串成一颗能跑
// 最小 RV64I 程序的【单周期 CPU】。
//
// 哈佛架构：指令与数据各走各的存储器（im / dm），所以取指与访存可以在同一拍
// 里同时发生。im 装 32 位指令字、dm 装 64 位数据字——差别只在实例参数上。
//
// 数据面与控制面在这一层合流，也在这一层再次分开：
//   数据面：rf.rdata1/2 → alu → 写回 → rf.wdata
//   控制面：ctl.* 一束控制位，决定"这一拍允许什么发生"
//
// 程序（8 条指令，一个真循环 + 一段访存；机器码由 run 块的 image 段装载）：
//     0: addi x1, x0, 0      累加和 x1 = 0（5+4+3+2+1 = 15）
//     4: addi x2, x0, 5      计数 x2 = 5
//     8: add  x1, x1, x2     ← 循环体：和 += 计数
//    12: addi x2, x2, -1     计数 -= 1
//    16: bne  x2, x0, -8     计数 ≠ 0 就回 8
//    20: sd   x1, 0(x0)      和写进数据存储器
//    24: ld   x8, 0(x0)      整字读回：x8 = 15
//    28: jal  x0, 0          停机（自跳）
// =============================================================================

import "pc.prism"
import "memory.prism"
import "alu.prism"
import "decoder.prism"

design cpu_top {
    // ==== 六颗实例 ====
    pc  : pc
    rf  : regfile
    ex  : alu
    im  : ram<SIZE = 256, W = u32, A = u8>    // 指令侧：32 位字，1KB
    dm  : ram<SIZE = 256, W = i64, A = u8>    // 数据侧：64 位字，2KB
    ctl : decoder

    // ==== 取指：pc → im（异步读，同拍出指令）====
    wire iaddr : u8 = pc.addr[9:2] -> im.addr      // 字节地址 → 字地址
    wire instr : u32 = im.rdata -> ctl.instr
    wire f3    : u3  = instr[14:12]                // 分支形态要看的那三位

    // ==== 译码输出 → 寄存器堆读口 ====
    connect ctl.rs1 -> rf.raddr1
    connect ctl.rs2 -> rf.raddr2
    connect ctl.rd  -> rf.waddr

    // ==== ALU 两个操作数 ====
    // 第二操作数三选一：立即数 / 寄存器堆读口 2；是移位时只取立即数低 6 位
    // （imm 的其余位是 funct6 与算术标志，不是移量）。
    wire is_shift   : u1  = ctl.alu_op in [5, 6, 8]
    wire alu_b_raw  : i64 = ctl.alu_src ? ctl.imm : rf.rdata2
    wire alu_b      : i64 = is_shift ? alu_b_raw[5:0] : alu_b_raw
    connect alu_b     -> ex.b
    connect rf.rdata1 -> ex.a

    // ==== 分支借 ALU 做比较 ====
    // decoder 的 alu_op 只管算术族（is_arith），分支那一族给的是 0（ADD）——地址
    // 通路不需要比较。所以"这条分支要比什么"在顶层补一列：beq/bne 借 SUB（结果
    // 为 0 即相等），blt/bge 借 SLT，bltu/bgeu 借 SLTU。
    wire alu_op_b : u4 = match f3 {
        0 => 1,     // beq  → SUB
        1 => 1,     // bne  → SUB
        4 => 7,     // blt  → SLT
        5 => 7,     // bge  → SLT
        6 => 9,     // bltu → SLTU
        _ => 9,     // bgeu → SLTU
    }
    wire alu_f : u4 = ctl.is_branch ? alu_op_b : ctl.alu_op -> ex.op

    // ==== W 型指令：结果按 32 位域解释，再符号扩展回 64 位 ====
    wire ex_word : i32 = ex.result[31:0]
    wire ex_ext  : i64 = ex_word                  // 符号扩展由类型声明负责
    wire alu_out : i64 = ctl.is_w_op ? ex_ext : ex.result

    // ==== 分支条件：借 ALU 的比较结果，按 funct3 选"成不成立" ====
    wire br_eq : u1 = alu_out == 0                // SUB 得 0 → 相等
    wire br_lt : u1 = alu_out == 1                // SLT / SLTU 得 1 → 小于
    wire br_ok : u1 = match f3 {
        0 => br_eq,                    // beq：相等即成立
        1 => br_eq == 0,               // bne：取反
        4 => br_lt,                    // blt
        5 => br_lt == 0,               // bge
        6 => br_lt,                    // bltu
        _ => br_lt == 0,               // bgeu
    }

    // ==== PC 下一步：分支成立 / jal / jalr 都算"载入" ====
    wire pc_load   : u1  = (ctl.is_branch & br_ok) | ctl.is_jal | ctl.is_jalr -> pc.load
    wire pc_target : u64 = ctl.is_jalr ? (rf.rdata1 + ctl.imm) : (pc.addr + ctl.imm)
    connect pc_target -> pc.target

    // ==== 访存：dm 存 64 位字 ====
    // 这一台的 dm 一颗就是 64 位字，所以访存只有双字（LD/SD）一条路：字节地址
    // 右移 3 就是字地址，写口整字进、整字出，没有半字选择、也没有读-改-写合并。
    // 落在半个字上的访问（addr[2]=1）这一台没有对应的电路，也不去判它。
    wire dm_index : u8 = ex.result[10:3] -> dm.addr
    connect ctl.mem_ren -> dm.ren
    connect 0 -> im.wen                                   // ROM：写口焊死
    connect 0 -> im.wdata
    connect 1 -> im.ren
    connect rf.rdata2 -> dm.wdata

    // ==== 这一台不做错误处理 ====
    // decoder 会举手报 is_illegal，但顶层不拿它当门：先让程序跑通，非法编码照样
    // 读、照样写回。把"不懂"变成一次异常跳转是第五日 CSR 与陷阱那一集的事。
    connect ctl.reg_wen -> rf.wen
    connect ctl.mem_wen -> dm.wen

    // ==== 写回三选一：load 数据 / 链接地址(pc+4) / ALU 结果 ====
    wire is_link : u1 = ctl.is_jal | ctl.is_jalr
    wire wb_data : i64 = ctl.mem_ren ? dm.rdata : (is_link ? u64(pc.addr + 4) : alu_out)
    connect wb_data -> rf.wdata

    // ==== 观测：pc、几个寄存器、dm 的前六个字 ====
    // 引出来的是"哪一格"由这颗芯片决定，看哪几格由每个 run 的 show 挑——第九集
    // 看循环与访存那几格，第九集拿同一颗 design 换镜像，看数组的六个字。
    expose pc.pc as pcv
    expose rf.regs[1] as x1
    expose rf.regs[2] as x2
    expose rf.regs[8] as x8
    expose rf.regs[11] as x11
    expose rf.regs[12] as x12
    expose rf.regs[13] as x13
    expose rf.regs[20] as x20
    expose dm.ram[0] as dm0
    expose dm.ram[1] as dm1
    expose dm.ram[2] as dm2
    expose dm.ram[3] as dm3
    expose dm.ram[4] as dm4
    expose dm.ram[5] as dm5
}

// cpu_check：27 拍自由运行。程序没有外部输入，期望只能挂在拍上，而 run 的
// stim 与 image 目前不共存，所以这张表靠逐拍手算核它。下一集的排序不这么办：
// 它换了一条会自己失败的判据（终态判据一坏，停机就从不成立）。
// 逐拍手算（观测点在边沿之后）：
//   拍 0..15  循环体五轮：x1 累加 5+4+3+2+1，x2 从 5 数到 0
//   拍 16     bne 不成立 → 顺行；此后 x1 = 15、x2 = 0 不再变
//   拍 16..20 beq x9, x10, +8：1 ≠ -1，不许跳——跳了就走不到 32 那条 addi
//   拍 20     x11 = 3 落地（分支判据正确的见证）
//   拍 21     slliw x12, x9, 31：1 左移 31 位在 32 位域里就是符号位 → x12 = -2147483648
//   拍 22     x13 = -1（-1 算术右移 1 位仍是 -1）
//   拍 23..24 sd x1 → dm[0] = 15；ld x8 → 整字读回 15
//   拍 26     52: jal x0, 0 自跳
run cpu_check of cpu_top {
    image : {
        prog : im[0:56] = [
            0x00000093,   //  0: addi x1, x0, 0      和 = 0
            0x00500113,   //  4: addi x2, x0, 5      计数 = 5
            0x002080b3,   //  8: add  x1, x1, x2     循环体：和 += 计数
            0xfff10113,   // 12: addi x2, x2, -1     计数 -= 1
            0xfe011ce3,   // 16: bne  x2, x0, -8     计数 ≠ 0 就回 8
            0x00100493,   // 20: addi x9, x0, 1      x9 = 1
            0xfff00513,   // 24: addi x10, x0, -1    x10 = -1
            0x00a48463,   // 28: beq  x9, x10, 8     1 ≠ -1：不许跳（借 ADD 就会跳）
            0x00300593,   // 32: addi x11, x0, 3     走到这里才写 → x11 = 3
            0x01f4961b,   // 36: slliw x12, x9, 31   W 型：按 32 位域算完再符号扩展
            0x4015569b,   // 40: sraiw x13, x10, 1   移量只占低 6 位：imm 的其余位不是移量
            0x00103023,   // 44: sd   x1, 0(x0)      和写进 dm[0]
            0x00003403,   // 48: ld   x8, 0(x0)      整字读回 → x8 = 15
            0x0000006f    // 52: jal  x0, 0          停机（自跳）
        ]
    }
    until : for 27 cycles
    show  : { pcv, x1, x2, x11, x12, x13, x8, dm0 }
}

// ----------------------------------------------------------------------------
// bubble_sort —— 第十集加的第二个 run：还是这颗 cpu_top，一行都不改，只换镜像。
// 待排的六个 64 位数故意倒着给（9, 7, 5, 3, 2, 1）。程序反复扫相邻两格，逆序就换；
// 有一趟一个没换就收尾，再从头部比一遍确认没有逆序，才把完工标志 x20 置 1。
// 停机判据就是这一位：排序或自检坏掉，它永不成立——把 slt 的两个源对调，
// 判据在 10000 拍内从不成立。
// 机器码由 llvm-mc 汇编核对（第二列是 llvm-objdump 的地址）。
// ----------------------------------------------------------------------------
run bubble_sort of cpu_top {
    image : {
        prog : im[0:] = [
            0x00600293,   //   0: addi x5, x0, 6         n = 6
            0x00000313,   //   4: addi x6, x0, 0         swapped = 0
            0x00000393,   //   8: addi x7, x0, 0         j = 0
            0x00339e13,   //  12: slli x28, x7, 3        &a[j] = j*8
            0x00138e93,   //  16: addi x29, x7, 1        j + 1
            0x003e9f13,   //  20: slli x30, x29, 3       &a[j+1]
            0x000e3503,   //  24: ld x10, 0(x28)         a[j]
            0x000f3583,   //  28: ld x11, 0(x30)         a[j+1]
            0x00a5a633,   //  32: slt x12, x11, x10      a[j+1] 比 a[j] 小？
            0x00060863,   //  36: beq x12, x0, 16        没逆序 → 跳到 52
            0x00be3023,   //  40: sd x11, 0(x28)         换：小的进来
            0x00af3023,   //  44: sd x10, 0(x30)         换：大的出去
            0x00130313,   //  48: addi x6, x6, 1         swapped++
            0x00138393,   //  52: addi x7, x7, 1         j++
            0xfff28693,   //  56: addi x13, x5, -1       n - 1
            0xfcd3c8e3,   //  60: blt x7, x13, -52       j < n-1 → 回 12
            0xfc0312e3,   //  64: bne x6, x0, -60        这趟换过 → 回 4 再扫
            0x00000393,   //  68: addi x7, x0, 0         自检：j = 0
            0xfff28693,   //  72: addi x13, x5, -1       n - 1
            0x00339e13,   //  76: slli x28, x7, 3        &a[j]
            0x00138e93,   //  80: addi x29, x7, 1        j + 1
            0x003e9f13,   //  84: slli x30, x29, 3       &a[j+1]
            0x000e3503,   //  88: ld x10, 0(x28)         a[j]
            0x000f3583,   //  92: ld x11, 0(x30)         a[j+1]
            0x00a5a633,   //  96: slt x12, x11, x10      还有逆序？
            0x00061c63,   // 100: bne x12, x0, 24        有 → 掉进 124 那格自跳，永不通
            0x00138393,   // 104: addi x7, x7, 1         j++
            0xfff28693,   // 108: addi x13, x5, -1       n - 1
            0xfcd3cee3,   // 112: blt x7, x13, -36       六对没比完 → 回 76
            0x00100a13,   // 116: addi x20, x0, 1        完工标志：直到这里才置 1
            0x0000006f,   // 120: jal x0, 0              停机（自跳）
            0x0000006f    // 124: jal x0, 0              fail：自检没过就永远停在这
        ]
        data : dm[0:] = [9, 7, 5, 3, 2, 1]   // 待排的六个字（dm 的前六格）
    }
    until : x20 == 1
    show  : { pcv, x20, dm0, dm1, dm2, dm3, dm4, dm5 }
}
