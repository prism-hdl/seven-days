// =============================================================================
// alu.prism —— 第二日 · 第 7 集：ALU，活动
//
// 纯组合，无时钟：op 选哪条路，结果立刻出来。
// 十种运算 + 一条防御性 `_ => 0`。白虹的真核里这里还挂着 M 扩展（乘除），
// 本集只放基础十条——这一天的机器还没有多周期的单元。
//
// ALU 也不管 32 位域运算：addw / subw 这些 W 型指令走的还是 ADD / SUB 这条路，
// 只是顶层按 decoder 报来的 is_w_op 把结果截到 32 位再符号扩展回去。32 位语义
// 是指令的属性，不是运算的属性，所以十条路一条都不必加。
//
// firmament 在这颗模块的端口上看得最清：
//   a / b       —— 数据面（值）
//   op          —— 控制面（选哪条路）
// 控制面从不参与运算，只决定这一拍走哪条；数据面从不影响选路。
// =============================================================================

module alu {
    in  a      : Signal<i64>    // 操作数 1
    in  b      : Signal<i64>    // 操作数 2（调用方已做好移位量掩码）
    in  op     : Signal<u4>     // 运算选择 0..9
    out result : Signal<i64>

    result = match op {
        0 => a + b,              // ADD
        1 => a - b,              // SUB
        2 => a & b,              // AND
        3 => a | b,              // OR
        4 => a ^ b,              // XOR
        5 => a << b,             // SLL（逻辑左移，b 已掩码）
        6 => a >> b,             // SRA（算术右移，保号）
        7 => a < b,              // SLT（有符号比较）
        8 => i64(u(a) >> b),     // SRL：换无符号视角移，补 0
        9 => u(a) < u(b),        // SLTU（无符号比较）
        _ => 0,                  // 防御：op 越界给 0
    }
}

@schedule alu {
    bitwidth  : { data:64 }
    pipeline  : 1 stage
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : adder = parallel(1)
    latency   : 1 cycle
}

design alu_top {
    dut : alu
}

// 逐拍手算：一组向量把十条路各打一遍（外加一次越界 op）。
// a=-2、b=33 是为右移准备的：移量 33 已经超过 32，只有 64 位通路才有的形态；
// 算术右移保号给 -1，逻辑右移补 0 给 2147483647。
run alu_check of alu_top {
    stim : {
        a, b, op, [result] = {
              5,    10,  0, [            15],   // ADD
             10,     5,  1, [             5],   // SUB
             12,    10,  2, [             8],   // AND
             12,    10,  3, [            14],   // OR
             12,    10,  4, [             6],   // XOR
              3,     4,  5, [            48],   // SLL
             -2,    33,  6, [            -1],   // SRA 保号
             -2,    33,  8, [    2147483647],   // SRL 补 0
              1,    40,  5, [ 1099511627776],   // SLL 2^40：32 位放不下
             -8,     1,  7, [             1],   // SLT：-8 < 1
             -8,     1,  9, [             0],   // SLTU：补全 1 的 -8 当成大数
              7,     7, 15, [             0],   // op 越界 → 0
        }
    }
    until : end of stim
    show  : { a, b, op, result }
}
