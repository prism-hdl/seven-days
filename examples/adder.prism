// =============================================================================
// adder.prism —— 第一集样例：最小的一束光。
//
// 一颗 32 位加法器：三个端口 + 一句 sum = a + b，没有任何跨拍状态。
// 它会在第 7 集被改造成 ALU（同一段组合数据流，长出十条运算的路）。
// =============================================================================

module adder {
    in  a   : Signal<u32>
    in  b   : Signal<u32>
    out sum : Signal<u32>

    sum = a + b
}

@schedule adder {
    bitwidth  : { data:32 }
    pipeline  : 1 stage
    reset     : async_low
    clock     : 100 MHz, domain = single
    resource  : none
    latency   : 1 cycle
}

design adder_top {
    dut : adder
}

run adder_check of adder_top {
    stim : {
        a, b, [sum] = {
                  1,          2,             [3],
                 10,         20,            [30],
                100,        200,           [300],
        }
    }
    until : end of stim
    show  : { a, b, sum }
}
